{
  "name": "truncate-budget",
  "version": "0.1.1",
  "description": "Truncate text to a UTF-8 byte budget and a line budget without splitting characters.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamelotWalker/truncate-budget.git"
  },
  "bugs": {
    "url": "https://github.com/KamelotWalker/truncate-budget/issues"
  },
  "homepage": "https://github.com/KamelotWalker/truncate-budget#readme",
  "keywords": [
    "truncate",
    "utf8",
    "utf-8",
    "byte-length",
    "line-limit",
    "cli",
    "llm",
    "ai-agent",
    "tool-output",
    "context-window",
    "log-truncation",
    "head-tail",
    "typescript",
    "zero-dependencies",
    "truncate-utf8-bytes",
    "truncate-utf8-bytes-alternative"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
